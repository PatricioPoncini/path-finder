# Copiá este archivo a .env y completá tu clave.
# Se obtiene en https://console.anthropic.com/ (API Keys).
ANTHROPIC_API_KEY=

# Opcional: modelo por defecto (también se puede fijar en data/preferences.yaml)
# JOBBOT_MODEL=claude-haiku-5-5

# Opcional: carpeta donde se guardan perfil, preferencias, historial y reportes (por defecto ./data)
# JOBBOT_HOME=

# Opcional: fuente Adzuna (registro gratis en https://developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
